# rq_output 전체는 무시하되, 현재 런의 rq_archive 폴더만 추적 허용
rq_output/*
!rq_output/rq_evolve_4b_domain_type_35cell_8gpu/
rq_output/rq_evolve_4b_domain_type_35cell_8gpu/*
!rq_output/rq_evolve_4b_domain_type_35cell_8gpu/rq_archive/

wandb/
analysis/
.raytmp/

# results/ carries the run record, and the per-benchmark logs are part of it:
# the quota failures that silently turned post-GPT scores into pre-GPT ones
# were only ever visible there, never in summary.json. The `logs/` rule above
# is for the repo's own scratch logs, not these.
!results/**/logs/
!results/**/logs/*.log
